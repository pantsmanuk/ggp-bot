# Slack Bot Configuration
# These are required for the bot to connect to Slack via Socket Mode
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here
SLACK_APP_TOKEN=xapp-your-app-level-token-here

# Intranet (Laravel 13) API Configuration
# 
# The bot uses two levels of authentication:
# 1. BOT TOKEN - Used for public endpoints (health checks, public holidays)
#    This is a global token with limited scopes (bot:read, bot:directory)
# 2. USER TOKENS - Individual Bearer tokens for each Slack user
#    These are obtained during account linking (/connect command) and stored
#    in data/tokens.db (SQLite with Fernet encryption). They have user-specific 
#    scopes like bot:holiday:read, bot:holiday:write for personal operations.
#
# The bot token is used for:
# - /api/health (health checks)
# - /api/holidays/public (public holidays)
# - /api/auth/slack-link (account linking)
#
# User tokens are used for:
# - /api/holidays/entitlement (personal holiday balance)
# - /api/holidays/mine (personal holiday requests)
# - /api/holidays/request (booking holidays)
# - /api/users/me (user profile)
#
INTRANET_BASE_URL=https://intranet.yourcompany.com
INTRANET_API_TOKEN=your-bot-bearer-token-here

# Token Encryption (Required for secure user token storage)
# 
# User tokens are encrypted at rest using Fernet symmetric encryption.
# Generate a key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANT: Keep this key secret and back it up! If lost, all stored tokens become unusable.
# If not provided, the bot will derive a key from machine-specific data (single-machine only).
TOKEN_ENCRYPTION_KEY=your-fernet-key-here

# Logging Configuration (optional)
#
# LOG_LEVEL: Controls verbosity (DEBUG, INFO, WARNING, ERROR, CRITICAL)
#   DEBUG = Very verbose, includes all API calls and responses
#   INFO = Normal operation (recommended for production)
#   WARNING = Only warnings and errors
#
# LOG_FILE: Path to log file (optional)
#   If set, logs go to both console AND this file
#   If not set, logs only go to console
#   Example: logs/ggp-bot.log (relative to working directory)
#
LOG_LEVEL=INFO
#LOG_FILE=logs/ggp-bot.log

# Data Directory (optional)
#
# Where SQLite databases and other data files are stored
# Default: "data" (relative to working directory)
#
#DATA_DIR=data

# Jenkins (planned feature - not yet implemented)
#JENKINS_BASE_URL=https://jenkins.yourcompany.com
#JENKINS_USER=your-jenkins-user
#JENKINS_TOKEN=your-jenkins-api-token
